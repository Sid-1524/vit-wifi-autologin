{
  "manifest_version": 3,
  "name": "VIT WiFi Auto Login",
  "version": "1.0",
  "description": "Fills (and optionally submits) the VIT/Pronto WiFi login form.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "http://phc.prontonetworks.com/cgi-bin/authlogin?URI=http://www.msftconnecttest.com/redirect"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}